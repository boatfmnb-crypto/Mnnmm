-- Variables Storage
_G.BB_Settings = {
    Aimbot = false,
    AimbotLevel = "ปกติ", -- ปกติ, กลาง, แรง
    ESP_Position = false,
    ESP_Health = false,
    ShowFOV = false,
    FOVSize = 50,
    InfinitePower = false
}

-- Helper Functions
local function createToggle(text, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = Container
    btn.Size = UDim2.new(1, -10, 0, 38)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    btn.Font = Enum.Font.SourceSans
    btn.Text = text .. " : [ปิด]"
    btn.TextColor3 = Color3.fromRGB(255, 100, 100)
    btn.TextSize = 16
    
    local enabled = false
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        if enabled then
            btn.Text = text .. " : [เปิด]"
            btn.TextColor3 = Color3.fromRGB(100, 255, 100)
        else
            btn.Text = text .. " : [ปิด]"
            btn.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
        callback(enabled)
    end)
end

-- 1. ล็อกหัว
createToggle("1. ล็อกหัว (Aimbot)", function(state)
    _G.BB_Settings.Aimbot = state
end)

-- 2. เลือกระดับล็อกหัว (ปกติ, กลาง, แรง)
local levelBtn = Instance.new("TextButton")
levelBtn.Parent = Container
levelBtn.Size = UDim2.new(1, -10, 0, 38)
levelBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
levelBtn.Font = Enum.Font.SourceSans
levelBtn.Text = "2. ระดับการล็อกหัว : [ปกติ]"
levelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
levelBtn.TextSize = 16

local levels = {"ปกติ", "กลาง", "แรง"}
local currentLevelIndex = 1
levelBtn.MouseButton1Click:Connect(function()
    currentLevelIndex = currentLevelIndex + 1
    if currentLevelIndex > #levels then currentLevelIndex = 1 end
    _G.BB_Settings.AimbotLevel = levels[currentLevelIndex]
    levelBtn.Text = "2. ระดับการล็อกหัว : [" .. levels[currentLevelIndex] .. "]"
end)

-- 3. เห็นตำแหน่งศัตรู
